client = TestClient(app)


class FakeQueryJob:
    def __init__(self, df):
        self._df = df

    def result(self):
        return self

    def to_dataframe(self):
        return self._df


class FakeBigQueryClient:
    """Stands in for google.cloud.bigquery.Client so tests never hit real BigQuery."""

    def __init__(self, df):
        self._df = df
        self.queries = []
        self.job_configs = []

    def query(self, sql, job_config=None):
        self.queries.append(sql)
        self.job_configs.append(job_config)
        return FakeQueryJob(self._df)


def bq_rows(rows):
    """rows pre-ordered the way BigQuery's ORDER BY would already return them."""
    return pd.DataFrame(rows, columns=["sku", "product_name", "volume", "value"])


def bq_months(months):
    return pd.DataFrame({"month": months})


def bq_weeks(period_starts):
    return pd.DataFrame({"period_start": period_starts})


def patch_bigquery(monkeypatch, df):
    fake_client = FakeBigQueryClient(df)
    monkeypatch.setattr(storage, "get_bigquery_client", lambda: fake_client)
    return fake_client


def param_value(job_config, name):
    return next(p.value for p in job_config.query_parameters if p.name == name)


