def test_treats_missing_revenue_as_zero_for_non_fairprice_retailers(monkeypatch):
    # revenue is only populated for FairPrice per the schema; a SKU sold
    # only through other retailers should still appear, ranked at 0 value
    # rather than being dropped or blowing up on a null.
    patch_bigquery(monkeypatch, bq_rows([
        ("SKU-A", "Widget A", 10, 0.0),
    ]))

    result = storage.get_sku_ranking(metric="value", month="2026-01")

    assert result.iloc[0]["value"] == 0.0


def test_shapes_a_realistic_multi_sku_result_correctly(monkeypatch):
    # Values below are the real GROUP BY sku output (SUM(quantity_units),
    # SUM(revenue), ORDER BY value DESC) from an actual export of the
    # client's aire-data.Aire_Data.sellout table (9 real SKUs, ~5800 weekly
    # rows across fairprice_online/fairprice_offline). Hardcoded here rather
    # than committing the raw export, since that's real client sales data.
    # This exercises rounding/rank-assignment against realistic magnitudes
    # and decimals, not just the small synthetic fixtures used elsewhere.
    fake_client = patch_bigquery(monkeypatch, bq_rows([
        ("13255044", "Aire Adult Pants S/M", 17133.0, 131165.78),
        ("13255045", "Aire Adult Pants L", 14009.0, 122949.00),
        ("13255043", "Aire Adult Pants XL", 10140.0, 102543.39),
        ("13271340", "Aire Ultra Pants L", 2967.0, 40366.75),
        ("13271337", "Aire Ultra Pants XL", 1777.0, 28997.46),
        ("13271339", "Aire Ultra Pants S/M", 2149.0, 25566.52),
        ("13271338", "Aire Ultra Tape L", 543.0, 4180.72),
        ("13271342", "Aire Ultra Tape XL", 258.0, 2748.46),
        ("13271341", "Aire Ultra Tape S/M", 206.0, 1591.39),
    ]))

    result = storage.get_sku_ranking(metric="value", month="2026-01")

    assert "ORDER BY value DESC" in fake_client.queries[0]
    assert len(result) == 9
    assert result.iloc[0]["sku"] == "13255044"
    assert result.iloc[0]["value"] == 131165.78
    assert result.iloc[0]["rank"] == 1
    assert result.iloc[-1]["sku"] == "13271341"
    assert result.iloc[-1]["rank"] == 9
    assert result["rank"].tolist() == list(range(1, 10))


