def fake_ranking_result(rows):
    df = pd.DataFrame(rows, columns=storage.SKU_RANKING_COLUMNS)
    return df


def test_defaults_to_ranking_by_value_descending(monkeypatch):
    monkeypatch.setattr(
        storage,
        "get_sku_ranking",
        lambda metric="value", order="desc", month=None, week=None: fake_ranking_result([
            ("SKU-B", "Widget B", 5, 500.0, 1),
            ("SKU-A", "Widget A", 10, 100.0, 2),
        ]),
    )

    res = client.get("/api/sales/skus", params={"month": "2026-01"})

    assert res.status_code == 200
    body = res.json()
    assert body["metric"] == "value"
    assert body["order"] == "desc"
    assert body["month"] == "2026-01"
    assert [row["sku"] for row in body["skus"]] == ["SKU-B", "SKU-A"]
    assert body["skus"][0]["rank"] == 1


