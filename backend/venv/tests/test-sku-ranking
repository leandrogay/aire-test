# --- storage.get_available_ranking_weeks ---


def test_get_available_ranking_weeks_numbers_weeks_relative_to_the_month_not_the_year(monkeypatch):
    # BigQuery's own period_label numbers weeks continuously across the
    # whole year (e.g. "Week 32" for early August), not restarting at 1
    # each month. The dropdown must always start at "Week 1" for whichever
    # month is selected, regardless of that week's position in the year -
    # these August dates prove it's not coincidentally correct only for
    # January.
    patch_bigquery(monkeypatch, bq_weeks(["2026-08-06", "2026-08-13"]))

    weeks = storage.get_available_ranking_weeks(month="2026-08")

    assert weeks == [
        {"value": "2026-08-06", "label": "Week 1 (06-08-2026)"},
        {"value": "2026-08-13", "label": "Week 2 (13-08-2026)"},
    ]


def test_get_available_ranking_weeks_numbers_a_five_week_month_up_to_five(monkeypatch):
    patch_bigquery(monkeypatch, bq_weeks([
        "2026-01-01", "2026-01-08", "2026-01-15", "2026-01-22", "2026-01-29",
    ]))

    weeks = storage.get_available_ranking_weeks(month="2026-01")

    assert [w["label"] for w in weeks] == [
        "Week 1 (01-01-2026)",
        "Week 2 (08-01-2026)",
        "Week 3 (15-01-2026)",
        "Week 4 (22-01-2026)",
        "Week 5 (29-01-2026)",
    ]


